{
  "$schema": "https://raw.githubusercontent.com/CrosswiredStudios/CSweetAgentSdk/main/schemas/csweet-plugin.v2.schema.json",
  "manifestVersion": "2.0",
  "kind": "agent",
  "rolePolicy": {
    "baseType": "individual-contributor",
    "profile": "individual-contributor.v1",
    "declaredRoleKeys": [
      "general-specialist",
      "research-analyst"
    ],
    "specializationKeys": [
      "real-estate-lead-research"
    ]
  },
  "id": "com.crosswiredstudios.agent.realtyleads",
  "name": "RealtyLeadsAI Lead Research Analyst",
  "version": "0.2.2",
  "publisher": {
    "id": "com.crosswiredstudios",
    "name": "CrosswiredStudios"
  },
  "runtime": {
    "type": "dotnet-project",
    "projectPath": "src/CSweet.Agent.RealtyLeadsAI/CSweet.Agent.RealtyLeadsAI.csproj",
    "targetFramework": "net10.0",
    "defaultActivationMode": "OnDemand",
    "defaultTickFrequencySeconds": 300,
    "supportsMultipleInstallations": true,
    "maximumConcurrentJobs": 1
  },
  "protocol": {
    "minimumVersion": "2.1",
    "maximumVersion": "2.x"
  },
  "provides": [
    {
      "name": "realtyleads.research.search.v1",
      "description": "Search subscribed inheritance leads.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "county": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "city": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "minScore": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "outputSchema": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inheritanceLeadId": {
              "type": [
                "string",
                "null"
              ]
            },
            "propertyId": {
              "type": [
                "string",
                "null"
              ]
            },
            "address": {
              "type": [
                "string",
                "null"
              ]
            },
            "ownerName": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "deceasedId": {
              "type": [
                "string",
                "null"
              ]
            },
            "deceasedName": {
              "type": [
                "string",
                "null"
              ]
            },
            "cityName": {
              "type": [
                "string",
                "null"
              ]
            },
            "countyName": {
              "type": [
                "string",
                "null"
              ]
            },
            "stateAbbreviation": {
              "type": [
                "string",
                "null"
              ]
            },
            "score": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "inheritanceLeadId",
            "propertyId",
            "address",
            "ownerName",
            "status",
            "deceasedId",
            "deceasedName",
            "cityName",
            "countyName",
            "stateAbbreviation",
            "score"
          ]
        }
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "none"
    },
    {
      "name": "realtyleads.research.lookup.v1",
      "description": "Look up a subscribed inheritance lead.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inheritanceLeadId": {
            "type": [
              "string",
              "null"
            ]
          },
          "propertyId": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerName": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "deceasedId": {
            "type": [
              "string",
              "null"
            ]
          },
          "deceasedName": {
            "type": [
              "string",
              "null"
            ]
          },
          "cityName": {
            "type": [
              "string",
              "null"
            ]
          },
          "countyName": {
            "type": [
              "string",
              "null"
            ]
          },
          "stateAbbreviation": {
            "type": [
              "string",
              "null"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "inheritanceLeadId",
          "propertyId",
          "address",
          "ownerName",
          "status",
          "deceasedId",
          "deceasedName",
          "cityName",
          "countyName",
          "stateAbbreviation",
          "score"
        ]
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "none"
    }
  ],
  "requires": [
    {
      "name": "realtyleads.inheritance.search.v1",
      "scope": "organization",
      "purpose": "Run one bounded inheritance-lead search per assignment.",
      "dependency": "realtyleads",
      "modelVisible": false
    },
    {
      "name": "realtyleads.inheritance.lookup.v1",
      "scope": "organization",
      "purpose": "Look up one subscribed inheritance lead by its returned ID.",
      "dependency": "realtyleads",
      "modelVisible": false
    },
    {
      "name": "platform.llm.chat-stream.v1",
      "scope": "organization",
      "purpose": "Interpret a bounded human research request using an approved model; provider results and research-brief lines are never sent to the model.",
      "modelVisible": false
    },
    {
      "name": "platform.artifact.create.v1",
      "scope": "organization",
      "purpose": "Save each delivered lead brief as a revisioned artifact with the reviewed fields.",
      "modelVisible": false
    },
    {
      "name": "work.delegation.create.v1",
      "scope": "organization",
      "purpose": "Required by the shared runtime to route a manager's accepted assignment to this analyst; the analyst never delegates.",
      "modelVisible": false
    },
    {
      "name": "work.delegation.read.v1",
      "scope": "organization",
      "purpose": "Read the assignment being acknowledged or executed.",
      "modelVisible": false
    },
    {
      "name": "work.delegation.respond.v1",
      "scope": "organization",
      "purpose": "Accept, clarify, report progress on and close assignments deterministically.",
      "modelVisible": false
    },
    {
      "name": "work.delegation.publish.v1",
      "scope": "organization",
      "purpose": "Shared runtime reporting of assignment updates.",
      "modelVisible": false
    },
    {
      "name": "work.tracking.read.v1",
      "scope": "organization",
      "purpose": "Shared runtime tracking reads.",
      "modelVisible": false
    },
    {
      "name": "work.tracking.pending.v1",
      "scope": "organization",
      "purpose": "Shared runtime bounded recovery of missed tracking updates.",
      "modelVisible": false
    },
    {
      "name": "work.tracking.processed.v1",
      "scope": "organization",
      "purpose": "Shared runtime acknowledgement of processed tracking updates.",
      "modelVisible": false
    }
  ],
  "events": {
    "subscribes": [
      "com.csweet.user.message.received.v1",
      "com.csweet.work.delegation.received.v1",
      "com.csweet.work.tracking.changed.v1"
    ]
  },
  "configuration": [],
  "credentials": [],
  "webAccess": {
    "mode": "None",
    "rules": []
  },
  "ui": [],
  "catalog": {
    "summary": "Lead Research Analyst: runs bounded RealtyLeadsAI inheritance-lead research from manager assignments or chat and delivers lead briefs.",
    "longDescription": "Takes a research brief (state, county/city, status, minimum score, limit) from a manager's assignment or a human request, runs exactly one read-only RealtyLeadsAI search through the explicitly granted connection, de-duplicates the records and delivers a lead brief with all reviewed fields. No outreach, record changes or hidden broadening.",
    "imageUrl": null,
    "companyLogoUrl": null,
    "accentColor": "#1C6252",
    "category": "General",
    "role": {
      "key": "realtyleads-research-analyst",
      "name": "Lead Research Analyst"
    },
    "license": {
      "spdxId": "MIT"
    },
    "iconUrls": [],
    "roleAliases": [],
    "keywords": [
      "real-estate",
      "leads",
      "research",
      "inheritance"
    ],
    "documentationUrl": "README.md"
  },
  "dependencies": [
    {
      "id": "realtyleads",
      "pluginId": "com.crosswiredstudios.plugin.realtyleads",
      "publisherId": "com.crosswiredstudios",
      "minimumVersion": "0.2.0",
      "maximumVersionExclusive": "1.0.0"
    }
  ]
}
